[configuration]

entry_symbol = "traffic_sim_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://bin/libtraffic_sim.macos.template_debug.framework"
macos.release = "res://bin/libtraffic_sim.macos.template_release.framework"
windows.debug.x86_64 = "res://bin/libtraffic_sim.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libtraffic_sim.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libtraffic_sim.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libtraffic_sim.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libtraffic_sim.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libtraffic_sim.linux.template_release.arm64.so"
web.debug.wasm32 = "res://bin/libtraffic_sim.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/libtraffic_sim.web.template_release.wasm32.nothreads.wasm"
web.debug.threads.wasm32 = "res://bin/libtraffic_sim.web.template_debug.wasm32.wasm"
web.release.threads.wasm32 = "res://bin/libtraffic_sim.web.template_release.wasm32.wasm"
